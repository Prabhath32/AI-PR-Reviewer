APP_NAME="AI PR Reviewer"
APP_ENV=local
APP_VERSION=0.1.0

LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=[]

# OpenAI — Phase 3
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4.1-mini

# Neon PostgreSQL — Phase 2
DATABASE_URL=
DATABASE_DIRECT_URL=

# GitHub integration — Phase 4
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Review limits
MAX_PR_FILES=200
MAX_DIFF_BYTES=1000000
MAX_AGENT_STEPS=12
MAX_REVIEW_COST_USD=1.00
